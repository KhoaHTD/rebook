  <diagram id="page7" name="08 Auction approval — added flow definitions">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="1110">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="08 Auction approval — added flow definitions" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1720" height="70" />
        </mxCell>
        <mxCell id="k0" value="S-IN4 | Seller → BookBid" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="130" width="340" height="145" />
        </mxCell>
        <mxCell id="v0" value="Auction request for exactly one book: book/listing identifier, title, photos and condition. Seller identity comes from the authenticated account. This submits for review; it does not start an auction." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="130" width="1380" height="145" />
        </mxCell>
        <mxCell id="k1" value="A-OUT4 | BookBid → Admin" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="285" width="340" height="145" />
        </mxCell>
        <mxCell id="v1" value="Auction requests awaiting review, with request identifier, book details and requesting seller. This dedicated flow is separate from general administrative information." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="285" width="1380" height="145" />
        </mxCell>
        <mxCell id="k2" value="A-IN4 | Admin → BookBid" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="340" height="145" />
        </mxCell>
        <mxCell id="v2" value="Decision tied to the request: approve or reject, with a reason where applicable. Approval authorizes later opening by the seller; it does not open the session automatically." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="440" width="1380" height="145" />
        </mxCell>
        <mxCell id="k3" value="S-IN5 | Seller → BookBid" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="595" width="340" height="145" />
        </mxCell>
        <mxCell id="v3" value="Request identifier or query criteria for viewing the seller’s own submitted requests (View request status)." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="595" width="1380" height="145" />
        </mxCell>
        <mxCell id="k4" value="S-OUT4 | BookBid → Seller" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="750" width="340" height="145" />
        </mxCell>
        <mxCell id="v4" value="Request status: PENDING, APPROVED or REJECTED, with its request/book identifiers and decision information. The seller sees the status of their own request." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="750" width="1380" height="145" />
        </mxCell>
        <mxCell id="k5" value="S-IN6 | Seller → BookBid" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="905" width="340" height="145" />
        </mxCell>
        <mxCell id="v5" value="Request to open a session for an approved auction request, with the required auction configuration. Session information and subsequent results return through S-OUT2. An opening attempt must not create duplicate active sessions." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="905" width="1380" height="145" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page8" name="09 Scope and completeness notes">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="1420">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="09 Scope and completeness notes" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1720" height="70" />
        </mxCell>
        <mxCell id="k0" value="Ranh giới hệ thống" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="130" width="340" height="145" />
        </mxCell>
        <mxCell id="v0" value="BookBid gồm ứng dụng, backend, worker, cơ sở dữ liệu và lưu trữ ảnh. Có 5 tác nhân ngoài: Guest, Buyer, Seller, Admin và Payment Gateway. Thanh toán online qua cổng bên thứ ba; COD và vận chuyển vẫn tự khai báo. Không tích hợp hãng vận chuyển." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="130" width="1380" height="145" />
        </mxCell>
        <mxCell id="k1" value="Vai trò và mức tổng quan" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="285" width="340" height="145" />
        </mxCell>
        <mxCell id="v1" value="Buyer và Seller là hai vai trò giao dịch của cùng loại tài khoản USER. Mỗi mũi tên là một luồng dữ liệu có hướng; các nhóm dữ liệu được giải thích ở trang 04–08. Các trường như tên và ảnh nằm trong một yêu cầu, không phải từng tác nhân hoặc tiến trình riêng." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="285" width="1380" height="145" />
        </mxCell>
        <mxCell id="k2" value="Bán giá cố định" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="440" width="340" height="145" />
        </mxCell>
        <mxCell id="v2" value="Bán giá cố định: Seller gửi tin đăng qua Listing and fulfillment data; Buyer xác nhận mua qua Purchase and bidding data. Thanh toán online dùng các luồng Payment initiation request, Payment instructions và Payment status riêng. COD được khai báo khi nhận hàng. Không yêu cầu duyệt đấu giá cho bán giá cố định." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="440" width="1380" height="145" />
        </mxCell>
        <mxCell id="k3" value="Điểm thay đổi so với SRS" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="595" width="340" height="145" />
        </mxCell>
        <mxCell id="v3" value="Yêu cầu bổ sung của người dùng: Seller gửi yêu cầu đấu giá → Admin duyệt/từ chối → Seller xem trạng thái → Seller chủ động mở phiên đã duyệt. Các luồng mới ở trang 08 thay đổi điều kiện publish auction của SRS v2; cần cập nhật SRS khi dùng bản này làm baseline." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="595" width="1380" height="145" />
        </mxCell>
        <mxCell id="k4" value="Thời lượng phiên" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="750" width="340" height="145" />
        </mxCell>
        <mxCell id="v4" value="Khoảng 15 phút là thời lượng ban đầu theo yêu cầu bổ sung. Nếu giữ anti-sniping của SRS, phiên có thể gia hạn khi có bid hợp lệ sát hạn. Buyer được xem mà không bắt buộc bid. Nếu không có bid, không tạo đơn thắng đấu giá." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="750" width="1380" height="145" />
        </mxCell>
        <mxCell id="k5" value="Đối chiếu dữ liệu" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="905" width="340" height="145" />
        </mxCell>
        <mxCell id="v5" value="Trang tổng quan có 35 luồng: 28 luồng nền và xét duyệt, 3 luồng thanh toán riêng với Buyer, 4 luồng với Payment Gateway. Các bảng truy vết cũ chỉ áp dụng cho 22 luồng nền; các bổ sung được định nghĩa ở trang 08 và 10." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="905" width="1380" height="145" />
        </mxCell>
        <mxCell id="k6" value="Nhất quán nghiệp vụ" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1060" width="340" height="145" />
        </mxCell>
        <mxCell id="v6" value="Dữ liệu của S-IN4 phải khớp sách thực tế khi mở phiên. Đề xuất: thay đổi nội dung đã duyệt phải gửi duyệt lại. Backend kiểm tra quyền, yêu cầu đã duyệt, chống mở trùng, chống tự bid và chống bán trùng. Quy tắc này cần đặc tả và kiểm thử, không được chứng minh chỉ bằng context diagram." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="1060" width="1380" height="145" />
        </mxCell>
        <mxCell id="k7" value="Cách đọc kết quả" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#E8F0FA;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1215" width="340" height="145" />
        </mxCell>
        <mxCell id="v7" value="S-OUT2 gồm thông tin phiên, kết quả đấu giá, đơn bán và trạng thái giao nhận/thanh toán. B-OUT2 gồm kết quả bid, kết quả phiên, đơn mua và trạng thái giao nhận; payment instructions/status có luồng riêng. A-OUT3 là kết quả xử lý của Admin; S-OUT4 là trạng thái duyệt trả Seller." style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;align=left;verticalAlign=middle;spacing=20;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="1215" width="1380" height="145" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="10 Payment gateway — proposed flow" id="payment-definitions">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="paytitle" value="PAYMENT GATEWAY — ĐỀ XUẤT BỔ SUNG PHẠM VI" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fontSize=30;fontStyle=1;strokeColor=none;">
          <mxGeometry x="50" y="20" width="1700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="head0" value="Buyer → BookBid | Payment initiation request" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="110" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body0" value="Yêu cầu thanh toán online cho đơn của buyer: order ID và khóa chống xử lý trùng. Backend tính số tiền từ đơn; không tin số tiền do client gửi. Áp dụng cho mua trực tiếp và đơn thắng đấu giá sau checkout." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="110" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head1" value="BookBid → Payment Gateway | Payment request" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="255" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body1" value="Tạo giao dịch: merchant order/reference, payment attempt ID, số tiền VND, mô tả, địa chỉ nhận thông báo và trang quay về. Đây là dữ liệu yêu cầu, không phải mũi tên biểu diễn tiền." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="255" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head2" value="Payment Gateway → BookBid | Payment response" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="400" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body2" value="Nhóm phản hồi giao dịch: mã giao dịch và URL thanh toán khi tạo thành công; thông báo trạng thái sau xử lý (pending/succeeded/failed/cancelled). Hai phản hồi có thể xảy ra ở các thời điểm khác nhau. URL thất bại hoặc khởi tạo thành công không đồng nghĩa đã trả tiền." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="400" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head3" value="BookBid → Buyer | Payment instructions" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="545" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body3" value="Trả URL thanh toán do cổng cung cấp hoặc lỗi khởi tạo. Buyer thực hiện thanh toán trên giao diện do cổng quản lý. Dữ liệu thẻ, mật khẩu và OTP không gửi về BookBid." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="545" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head4" value="BookBid → Buyer | Payment status" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="690" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body4" value="Trả trạng thái đã được backend xác minh và mã tham chiếu. Buyer xem lại trạng thái qua yêu cầu tra cứu cá nhân. Không tin riêng kết quả redirect trên trình duyệt. Seller nhận trạng thái qua Listing and sales information." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="690" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head5" value="BookBid → Payment Gateway | Refund request" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="835" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body5" value="Khi hủy đơn/giải quyết tranh chấp đủ điều kiện và đã thu tiền: gửi mã giao dịch gốc, mã hoàn tiền duy nhất, số tiền và lý do. Đề xuất chỉ hoàn toàn bộ khoản online đã thu, không hoàn vượt số tiền đó." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="835" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head6" value="Payment Gateway → BookBid | Refund result" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="980" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body6" value="Mã hoàn tiền và trạng thái pending/succeeded/failed. Chỉ đánh dấu REFUNDED khi cổng xác nhận thành công; gửi kết quả tới Buyer/Seller qua Case outcomes and notifications. Lỗi hoàn tiền được đưa vào thông tin quản trị để xử lý." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="980" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head7" value="Quy tắc đề xuất cần đưa vào SRS" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="1125" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body7" value="Xác minh chữ ký/xác thực callback, mã đơn, số tiền và VND. Callback trùng không cập nhật hai lần; kết quả thất bại cũ không ghi đè giao dịch đã thành công. Nếu cổng báo thành công sau khi đơn đã hủy/hết hạn: không mở lại đơn, chuyển xử lý hoàn tiền. Không giao hàng online khi chưa xác nhận đã thanh toán." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="1125" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head8" value="Phạm vi và quan hệ ngoài ranh giới" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="1270" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body8" value="COD không qua gateway; xác nhận COD vẫn nằm trong dữ liệu nhận hàng. Bản context chỉ vẽ dữ liệu qua ranh giới BookBid; tương tác Buyer trên trang cổng không nối trực tiếp giữa hai tác nhân. Quyết toán cho seller theo cấu hình thương mại của cổng, chưa thiết kế ví, escrow hoặc payout tự động trong BookBid." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="1270" width="1200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="head9" value="Thay đổi baseline" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;fillColor=#e8f4ef;align=left;spacing=15;fontSize=23;fontStyle=1;">
          <mxGeometry x="50" y="1415" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="body9" value="Đây là flow đề xuất theo yêu cầu mới, thay thế thanh toán MOCK_ONLINE nội bộ. Cổng cụ thể chưa được chọn; có thể tích hợp sandbox trước. Các trang truy vết cũ tham chiếu SRS v2 chỉ làm nền, không chứng minh phần tích hợp mới đã có trong SRS. Luồng duyệt đấu giá giữ nguyên." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#25364a;strokeWidth=2;align=left;spacing=15;fontSize=23;">
          <mxGeometry x="550" y="1415" width="1200" height="135" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
