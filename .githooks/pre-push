#!/bin/sh
# LUẬT CỨNG: không đẩy code apps/backend lên nhánh interface HOẶC bất kỳ nhánh con nào của nó
# (nhánh con = nhánh có chứa commit của interface, vd. admin/..., staff/..., fix/...).
# Nhánh backend cắt từ main thì không bị ảnh hưởng.
# Bật một lần sau khi clone:  git config core.hooksPath .githooks
# Cùng luật có ở hook Claude (apps/frontend/tool/hooks/claude_hook.dart) và CI (.github/workflows/backend-guard.yml).
# (Khi interface đã merge hết vào main, gỡ luật ở cả ba nơi.)
FRONTEND="interface"
ZERO="0000000000000000000000000000000000000000"

# Mốc frontend: ưu tiên origin/<nhánh>, không có thì nhánh local cùng tên.
frontend_ref=""
for r in "origin/$FRONTEND" "$FRONTEND"; do
  if git rev-parse --verify --quiet "$r" >/dev/null; then frontend_ref="$r"; break; fi
done

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # xoá nhánh: không có gì để kiểm

  if [ "$remote_ref" = "refs/heads/$FRONTEND" ]; then
    if [ "$remote_sha" = "$ZERO" ]; then
      base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
    else
      base="$remote_sha"
    fi
  elif [ -n "$frontend_ref" ] && git merge-base --is-ancestor "$frontend_ref" "$local_sha" 2>/dev/null; then
    base=$(git merge-base "$frontend_ref" "$local_sha")
  else
    continue # không phải nhánh frontend / nhánh con
  fi

  if [ -z "$base" ] || ! git cat-file -e "$base" 2>/dev/null; then
    echo "pre-push: chưa kiểm được thay đổi (thiếu commit gốc). Chạy 'git fetch' rồi push lại." >&2
    exit 1
  fi
  files=$(git diff --name-only "$base" "$local_sha" -- apps/backend)
  if [ -n "$files" ]; then
    echo "" >&2
    echo "PUSH BỊ CHẶN ($remote_ref): code backend không được lên $FRONTEND hay nhánh con của nó:" >&2
    echo "$files" | sed 's/^/  - /' >&2
    echo "Bỏ thay đổi apps/backend khỏi commit, hoặc làm việc backend ở nhánh cắt từ main." >&2
    exit 1
  fi
done
exit 0
