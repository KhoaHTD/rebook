#!/bin/sh
# LUẬT CỨNG: không đẩy code apps/backend lên nhánh design/apple-books (nhánh chỉ chứa frontend).
# Bật một lần sau khi clone:  git config core.hooksPath .githooks
# Cùng luật có ở hook Claude (apps/frontend/tool/hooks/claude_hook.dart) và CI (.github/workflows/backend-guard.yml).
PROTECTED="refs/heads/design/apple-books"
ZERO="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$PROTECTED" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue # xoá nhánh: không có gì để kiểm
  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ] || ! git cat-file -e "$base" 2>/dev/null; then
    echo "pre-push: chưa kiểm được thay đổi (thiếu commit gốc). Chạy 'git fetch' rồi push lại." >&2
    exit 1
  fi
  files=$(git diff --name-only "$base" "$local_sha" -- apps/backend)
  if [ -n "$files" ]; then
    echo "" >&2
    echo "PUSH BỊ CHẶN: các file backend không được lên design/apple-books:" >&2
    echo "$files" | sed 's/^/  - /' >&2
    echo "Nhánh này chỉ chứa frontend. Bỏ thay đổi apps/backend khỏi commit (hoặc làm ở nhánh khác / main)." >&2
    exit 1
  fi
done
exit 0
