# Mẫu cấu hình riêng của từng máy. Chép thành apps/backend/.env (file đó không commit) rồi điền giá trị:
#   Windows:  copy env.example .env        macOS / Linux:  cp env.example .env
# Spring đọc .env khi chạy trong apps/backend (cả ./mvnw spring-boot:run lẫn ./mvnw test), mỗi dòng KHÓA=giá trị.
# Dòng bắt đầu bằng # là chú thích; bỏ # để dùng. Không điền mật khẩu thật vào file mẫu này (nó được commit).

# ---- Profile: mặc định là prod (không lộ OTP, không có nút giả lập thanh toán, không nạp dữ liệu mẫu) ----
# Máy dev bỏ # dòng dưới để có dữ liệu mẫu, devOtp và giả lập thanh toán. KHÔNG bật khi deploy.
# spring.profiles.active=dev
# Chạy ngoài dev / test thì bắt buộc đặt JWT_SECRET (>= 32 ký tự), thiếu là backend không khởi động.
# JWT_SECRET=

# ---- PostgreSQL (mặc định: localhost:5432, DB rebook_dev, user rebook / mật khẩu rebook) ----
DB_URL=jdbc:postgresql://localhost:5432/rebook_dev
DB_USERNAME=rebook
DB_PASSWORD=rebook
# Test chạy trong schema rebook_test của cùng DB; chỉ đặt khi muốn dùng DB khác cho test
# TEST_DB_URL=jdbc:postgresql://localhost:5432/rebook_dev?currentSchema=rebook_test

# ---- Gửi mail (docs/ra-soat-nghiep-vu/THIET_KE_GUI_MAIL.md) ----
# false = không gửi, chỉ ghi log người nhận và tiêu đề. true = gửi SMTP thật; bật mà thiếu MAIL_HOST thì backend không khởi động.
MAIL_ENABLED=false
# Gmail: smtp.gmail.com, cổng 587, MAIL_USER là địa chỉ Gmail, MAIL_PASS là "mật khẩu ứng dụng" 16 ký tự (cần bật xác minh 2 bước).
# Brevo: smtp-relay.brevo.com, cổng 587, user / key SMTP lấy trong trang quản lý Brevo.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Người gửi hiện trong hộp thư. Gmail chỉ cho gửi bằng chính địa chỉ MAIL_USER (hoặc bí danh đã xác minh).
MAIL_FROM=ReBook <no-reply@rebook.vn>

# ---- ZaloPay sandbox (để trống ZALOPAY_APP_ID = tắt ZaloPay, dùng cổng giả lập ở dev) ----
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=
# Bản web của app, dùng cho trang ZaloPay quay về và đường dẫn trong mail
# APP_URL=http://localhost:5199
